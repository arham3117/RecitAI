# Copy to .env and adjust. .env is gitignored.
# Spec §8. DATABASE_URL differs from the spec: Postgres from Phase 0 (D-001).

# Dev: Ollama runs natively on the host (D-002).
# Hosted: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=recitai_chunks

# Port 5433, not 5432: Homebrew postgresql@14 occupies 5432 on this machine (I-020).
DATABASE_URL=postgresql+asyncpg://recitai:recitai@localhost:5433/recitai

GEN_MODEL=llama3.1:8b-instruct-q5_K_M
EMBEDDING_MODEL=nomic-embed-text

LOG_LEVEL=INFO
# "console" for development, "json" in production (§16 task 6).
LOG_FORMAT=console

# An 8B model on a cold load can take well over a minute to return its first token; a
# conventional short timeout surfaces as an inscrutable failure rather than as slowness.
LLM_TIMEOUT_SECONDS=300

# Prompt versions are configuration so §15 task 7's A/B is not a code edit. v2 exists and
# was measured worse — see plan/ISSUES.md I-028.
QUESTION_PROMPT=question_generation_v1
JUDGE_PROMPT=validator_judge_v1
