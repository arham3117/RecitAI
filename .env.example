# Copy to .env and adjust. .env is gitignored.
# Spec §8. DATABASE_URL differs from the spec: Postgres from Phase 0 (D-001).

# Dev: Ollama runs natively on the host (D-002).
# Hosted: http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=recitai_chunks

# Port 5433, not 5432: Homebrew postgresql@14 occupies 5432 on this machine (I-020).
DATABASE_URL=postgresql+asyncpg://recitai:recitai@localhost:5433/recitai

GEN_MODEL=llama3.1:8b-instruct-q5_K_M
EMBEDDING_MODEL=nomic-embed-text

LOG_LEVEL=INFO
